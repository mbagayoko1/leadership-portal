# Copy to .env and fill in from your Supabase project (Settings → API).
# Leave unset to run fully on localStorage (per-browser data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Coach proxy (supabase/functions/ai-coach). When unset, each user can
# connect the AI Coach with their own Anthropic API key instead.
VITE_AI_PROXY_URL=
